{
    "name": "umiushi-lab/swiftmailer",
    "type": "library",
    "description": "Swift Mailer 5.4.12 with security fixes backported, for EC-CUBE 3.0.x shops that cannot move off the versions EC-CUBE 3.0.18 ships",
    "keywords": [
        "mail",
        "mailer",
        "email"
    ],
    "homepage": "https://swiftmailer.symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Corbyn"
        },
        {
            "name": "Fabien Potencier",
            "email": "fabien@symfony.com"
        }
    ],
    "require": {
        "php": ">=5.3.3"
    },
    "autoload": {
        "files": [
            "lib/swift_required.php"
        ]
    },
    "autoload-dev": {
        "psr-0": {
            "Swift_": "tests/unit"
        }
    },
    "replace": {
        "swiftmailer/swiftmailer": "5.4.12"
    },
    "support": {
        "issues": "https://github.com/umiushi-lab/swiftmailer/issues"
    }
}
